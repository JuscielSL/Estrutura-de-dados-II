Critério de contagem adotado:

Comparação: cada vez que o algoritmo verifica se um elemento é maior, menor ou igual a outro.
Troca: conta 1 operação quando dois elementos são trocados de posição.
Movimentação no Insertion e Quick: cada atribuição que desloca ou reposiciona um elemento é contabilizada como uma movimentação.
Como o número exato de operações depende da implementação e da semente dos números aleatórios, o programa abaixo gera os valores reais ao ser executado, em vez de inventar resultados.

Código completo
import random


# ============================================================
# BUBBLE SORT
# ============================================================
def bubble_sort(vetor):
    comparacoes = 0
    trocas = 0

    n = len(vetor)

    for i in range(n - 1):
        houve_troca = False

        for j in range(n - 1 - i):
            comparacoes += 1

            if vetor[j] > vetor[j + 1]:
                vetor[j], vetor[j + 1] = vetor[j + 1], vetor[j]
                trocas += 1
                houve_troca = True

        if not houve_troca:
            break

    return comparacoes, trocas


# ============================================================
# INSERTION SORT
# ============================================================
def insertion_sort(vetor):
    comparacoes = 0
    movimentacoes = 0

    for i in range(1, len(vetor)):
        chave = vetor[i]
        j = i - 1

        while j >= 0:
            comparacoes += 1

            if vetor[j] > chave:
                vetor[j + 1] = vetor[j]
                movimentacoes += 1
                j -= 1
            else:
                break

        # Colocação da chave em sua posição
        vetor[j + 1] = chave
        movimentacoes += 1

    return comparacoes, movimentacoes


# ============================================================
# SELECTION SORT
# ============================================================
def selection_sort(vetor):
    comparacoes = 0
    trocas = 0

    n = len(vetor)

    for i in range(n - 1):
        menor = i

        for j in range(i + 1, n):
            comparacoes += 1

            if vetor[j] < vetor[menor]:
                menor = j

        if menor != i:
            vetor[i], vetor[menor] = vetor[menor], vetor[i]
            trocas += 1

    return comparacoes, trocas


# ============================================================
# QUICK SORT
# ============================================================
def quick_sort(vetor):
    comparacoes = 0
    movimentacoes = 0

    def particionar(esquerda, direita):
        nonlocal comparacoes, movimentacoes

        pivo = vetor[direita]
        i = esquerda - 1

        for j in range(esquerda, direita):
            comparacoes += 1

            if vetor[j] <= pivo:
                i += 1

                if i != j:
                    vetor[i], vetor[j] = vetor[j], vetor[i]
                    movimentacoes += 1

        if i + 1 != direita:
            vetor[i + 1], vetor[direita] = (
                vetor[direita],
                vetor[i + 1]
            )
            movimentacoes += 1

        return i + 1

    def ordenar(esquerda, direita):
        if esquerda < direita:
            posicao_pivo = particionar(esquerda, direita)

            ordenar(esquerda, posicao_pivo - 1)
            ordenar(posicao_pivo + 1, direita)

    ordenar(0, len(vetor) - 1)

    return comparacoes, movimentacoes


# ============================================================
# EXPERIMENTO
# ============================================================
def executar_experimento(tamanho):
    # Gera UM único vetor original
    original = [random.randint(1, 10000) for _ in range(tamanho)]

    # Quatro cópias idênticas
    vetor_bubble = original.copy()
    vetor_insertion = original.copy()
    vetor_selection = original.copy()
    vetor_quick = original.copy()

    # Executa os algoritmos
    bubble_comp, bubble_trocas = bubble_sort(vetor_bubble)

    insertion_comp, insertion_mov = insertion_sort(vetor_insertion)

    selection_comp, selection_trocas = selection_sort(vetor_selection)

    quick_comp, quick_mov = quick_sort(vetor_quick)

    # Verifica se todos realmente ordenaram corretamente
    esperado = sorted(original)

    assert vetor_bubble == esperado
    assert vetor_insertion == esperado
    assert vetor_selection == esperado
    assert vetor_quick == esperado

    return [
        tamanho,
        bubble_comp,
        bubble_trocas,
        insertion_comp,
        insertion_mov,
        selection_comp,
        selection_trocas,
        quick_comp,
        quick_mov
    ]


# ============================================================
# DESAFIO ADICIONAL
# ============================================================
def experimento_desafio(tamanho):
    aleatorio = [random.randint(1, 10000) for _ in range(tamanho)]
    ordenado = sorted(aleatorio)
    inverso = sorted(aleatorio, reverse=True)

    vetores = {
        "Aleatório": aleatorio,
        "Ordenado": ordenado,
        "Inverso": inverso
    }

    for nome, original in vetores.items():

        print(f"\n--- {nome} ---")

        # Bubble
        v = original.copy()
        comp, mov = bubble_sort(v)
        print(f"Bubble Sort     -> Comparações: {comp}, Trocas: {mov}")

        # Insertion
        v = original.copy()
        comp, mov = insertion_sort(v)
        print(f"Insertion Sort  -> Comparações: {comp}, Mov.: {mov}")

        # Selection
        v = original.copy()
        comp, mov = selection_sort(v)
        print(f"Selection Sort  -> Comparações: {comp}, Trocas: {mov}")

        # Quick
        v = original.copy()
        comp, mov = quick_sort(v)
        print(f"Quick Sort      -> Comparações: {comp}, Mov.: {mov}")


# ============================================================
# PROGRAMA PRINCIPAL
# ============================================================

resultados = []

for tamanho in [10, 20, 1000]:
    resultado = executar_experimento(tamanho)
    resultados.append(resultado)


